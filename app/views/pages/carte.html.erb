<%# ========================================== %>
<%# HERO AVEC PHOTO %>
<%# ========================================== %>
<% hero_img = site_photo_for("carte_hero") %>
<section class="relative -mt-20 h-[50vh] min-h-[400px] max-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- Image de fond -->
  <img src="<%= hero_img[:url] %>" alt="<%= hero_img[:alt] %>" class="absolute inset-0 w-full h-full object-cover">

  <!-- Overlay sombre -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>

  <!-- Contenu -->
  <div class="relative z-10 container mx-auto px-4 pt-20 text-center text-white">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-4 drop-shadow-lg">
      La carte
    </h1>
    <p class="text-xl md:text-2xl text-cream-100 drop-shadow font-light">
      Cuisine maison — Produits frais & de saison
    </p>
  </div>
</section>

<%# ========================================== %>
<%# LA CARTE %>
<%# ========================================== %>
<section class="section-padding bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto">

      <%# NOS ENTRÉES %>
      <% if @entrees.any? %>
        <div class="mb-20" data-controller="scroll-animation">
          <h2 class="text-3xl font-serif font-bold text-forest-800 mb-10 text-center">
            Nos entrées
          </h2>

          <div class="space-y-6">
            <% @entrees.each do |item| %>
              <div class="border-b border-dotted border-sage-300 pb-2">
                <div class="flex justify-between items-baseline">
                  <span class="font-medium text-forest-800 pr-4"><%= item.name %></span>
                  <span class="font-semibold text-forest-600"><%= item.formatted_price %></span>
                </div>
                <% if item.description.present? %>
                  <p class="text-sm text-sage-600 mt-1"><%= item.description %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# NOS PLATS %>
      <% if @plats.any? %>
        <div class="mb-20" data-controller="scroll-animation">
          <h2 class="text-3xl font-serif font-bold text-forest-800 mb-10 text-center">
            Nos plats
          </h2>

          <div class="space-y-6">
            <% @plats.each do |item| %>
              <div class="border-b border-dotted border-sage-300 pb-2">
                <div class="flex justify-between items-baseline">
                  <span class="font-medium text-forest-800 pr-4"><%= item.name %></span>
                  <span class="font-semibold text-forest-600"><%= item.formatted_price %></span>
                </div>
                <% if item.description.present? %>
                  <p class="text-sm text-sage-600 mt-1"><%= item.description %></p>
                <% end %>
              </div>
            <% end %>

            <p class="text-center text-sage-600 italic pt-4">Suggestions à l'ardoise selon arrivages</p>
          </div>
        </div>
      <% end %>

      <%# NOS DESSERTS %>
      <% if @desserts.any? %>
        <div class="mb-16" data-controller="scroll-animation">
          <h2 class="text-3xl font-serif font-bold text-forest-800 mb-10 text-center">
            Nos desserts
          </h2>

          <div class="space-y-6">
            <% @desserts.each do |item| %>
              <div class="border-b border-dotted border-sage-300 pb-2">
                <div class="flex justify-between items-baseline">
                  <span class="font-medium text-forest-800 pr-4"><%= item.name %></span>
                  <span class="font-semibold text-forest-600"><%= item.formatted_price %></span>
                </div>
                <% if item.description.present? %>
                  <p class="text-sm text-sage-600 mt-1"><%= item.description %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</section>

<%# ========================================== %>
<%# NOS FORMULES %>
<%# ========================================== %>
<section class="section-padding bg-forest-800">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-12 text-center" data-controller="scroll-animation">
        Nos formules
      </h2>

      <div class="grid md:grid-cols-3 gap-8" data-controller="scroll-animation" data-scroll-animation-animation-value="fade-in">

        <% @formulas.each do |formula| %>
          <div class="bg-white rounded-2xl p-8 text-center">
            <h3 class="text-xl font-serif font-bold text-forest-800 mb-4"><%= formula.name %></h3>
            <% if formula.description.present? %>
              <p class="text-forest-700 mb-2"><%= formula.description %></p>
            <% end %>
            <p class="text-4xl font-bold text-forest-600 mb-4"><%= formula.formatted_price %></p>
          </div>
        <% end %>

        <%# Groupes %>
        <div class="bg-white rounded-2xl p-8 text-center flex flex-col">
          <h3 class="text-xl font-serif font-bold text-forest-800 mb-6">Groupes</h3>
          <p class="text-forest-700 mb-6 flex-1 flex items-center justify-center">Formules sur mesure pour vos événements</p>
          <a href="mailto:sasvmrestaurations@gmail.com" class="text-forest-600 font-semibold hover:text-forest-800 transition-colors underline underline-offset-4">
            Demander un devis
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<%# ========================================== %>
<%# CTA RÉSERVATION %>
<%# ========================================== %>
<section class="py-16 bg-sage-50">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center" data-controller="scroll-animation">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-forest-800 mb-4">
        Réservez votre table
      </h2>
      <p class="text-forest-600 mb-8">
        Service du midi tous les jours
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:0961631527" class="btn-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          09 61 63 15 27
        </a>
        <%= link_to vins_path, class: "text-forest-600 font-medium hover:text-forest-800 transition-colors" do %>
          Voir la carte des vins
          <svg class="w-4 h-4 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</section>
