<!-- En-tête -->
<section class="relative py-24 bg-gradient-to-br from-forest-900 via-forest-800 to-forest-700">
  <div class="absolute inset-0 bg-black/30"></div>
  <div class="relative z-10 container mx-auto px-4 text-center text-white">
    <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4">
      <span class="text-gold-400">Les vins</span> de notre cave
    </h1>
    <p class="text-xl md:text-2xl text-cream-100">Restaurant ouvert à tous !</p>
  </div>
</section>

<!-- Carrousel de photos de vins -->
<% vins_images = site_photos_for("vins_carousel") %>
<section class="py-12 bg-wood-100">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <%= render "shared/carousel", images: vins_images, options: { height: "h-64 md:h-80", rounded: "rounded-lg" } %>
    </div>
  </div>
</section>

<!-- Carte des Vins -->
<section class="py-16 bg-cream-50">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Introduction -->
      <div class="text-center mb-16">
        <div class="inline-block">
          <svg class="w-16 h-16 mx-auto text-gold-500 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 3l1 8h10l1-8H6zm2 10v8h8v-8H8zm2 2h4v4h-4v-4z"/>
          </svg>
        </div>
        <p class="text-lg text-forest-700 italic">Une sélection de vins soigneusement choisis pour accompagner vos repas</p>
      </div>

      <%# Helper pour générer une section de vins %>
      <% wine_sections = [
        { wines: @blancs, label: "Notre sélection de vins blancs", color_bg: "bg-amber-200", color_border: "border-amber-400" },
        { wines: @roses, label: "Notre sélection de vins rosés", color_bg: "bg-pink-300", color_border: "border-pink-400" },
        { wines: @rouges, label: "Notre sélection de vins rouges", color_bg: "bg-red-800", color_border: "border-red-900" }
      ] %>

      <% wine_sections.each do |section| %>
        <% next if section[:wines].empty? %>
        <div class="wine-category mb-16" data-controller="scroll-animation">
          <div class="flex items-center gap-4 mb-8">
            <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent hidden md:block"></div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full <%= section[:color_bg] %> border-2 <%= section[:color_border] %>"></span>
              <h2 class="text-xl md:text-3xl font-serif font-bold text-forest-800"><%= section[:label] %></h2>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent hidden md:block"></div>
          </div>

          <div class="bg-white rounded-xl shadow-lg overflow-x-auto">
            <table class="w-full min-w-[400px]">
              <thead>
                <tr class="bg-forest-800 text-white">
                  <th class="py-4 px-6 text-left font-serif">Vin</th>
                  <th class="py-4 px-4 text-center font-serif w-24">Verre</th>
                  <th class="py-4 px-4 text-center font-serif w-28">Bouteille</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-cream-200">
                <% section[:wines].each do |wine| %>
                  <tr class="hover:bg-cream-50 transition-colors">
                    <td class="py-4 px-6">
                      <p class="font-semibold text-forest-800"><%= wine.name %></p>
                      <% if wine.appellation.present? %>
                        <p class="text-sm text-forest-600 italic"><%= wine.appellation %></p>
                      <% end %>
                    </td>
                    <td class="py-4 px-4 text-center">
                      <% if wine.glass_price.present? %>
                        <span class="inline-block bg-gold-100 text-gold-700 font-bold px-3 py-1 rounded-full"><%= wine.formatted_glass_price %></span>
                      <% else %>
                        <span class="text-forest-400">—</span>
                      <% end %>
                    </td>
                    <td class="py-4 px-4 text-center">
                      <% if wine.bottle_price.present? %>
                        <span class="inline-block bg-forest-100 text-forest-700 font-bold px-3 py-1 rounded-full"><%= wine.formatted_bottle_price %></span>
                      <% else %>
                        <span class="text-forest-400">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <!-- Note -->
      <div class="text-center mt-12 p-6 bg-forest-800 rounded-xl text-white">
        <p class="text-lg mb-2">
          <span class="text-gold-400 font-serif font-bold">Notre conseil :</span>
          N'hésitez pas à demander conseil à notre équipe pour l'accord mets et vins.
        </p>
        <p class="text-cream-200 text-sm">La carte des vins peut évoluer selon les arrivages et les saisons.</p>
      </div>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-12 bg-gold-400">
  <div class="container mx-auto px-4 text-center">
    <h3 class="text-2xl font-serif font-bold text-forest-900 mb-6">Envie de découvrir notre carte ?</h3>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <%= link_to carte_path, class: "btn-cta-dark" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        Voir la carte du restaurant
      <% end %>
      <a href="tel:0961631527" class="btn-cta-dark">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        Réserver : 09 61 63 15 27
      </a>
    </div>
  </div>
</section>
